<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS configuration for this SPA (single-page application).

  PREREQUISITES (install on the IIS server, in this order):
    1. URL Rewrite Module 2.1
       https://www.iis.net/downloads/microsoft/url-rewrite
    2. Application Request Routing (ARR) 3.0  -- ONLY needed for the
       /api and /uploads reverse-proxy rules below.
       https://www.iis.net/downloads/microsoft/application-request-routing
       After installing ARR: open IIS Manager -> server node ->
       Application Request Routing Cache -> Server Proxy Settings ->
       tick "Enable proxy" -> Apply.

  BACKEND ADDRESS:
    Update the two rewrite URLs below (http://192.168.1.34:81) if your
    API server moves. Keep them in sync with vite.config.ts (dev proxy).

  DEPLOYMENT:
    Run `npm run build`, then point the IIS site's physical path at the
    generated `dist` folder (this file is copied there automatically).
-->
<configuration>
  <system.webServer>
    <!--
      WebDAVModule (loaded whenever the IIS "WebDAV Publishing" feature is
      installed) claims PUT/DELETE/PROPFIND for itself and answers them with
      "405 Method Not Allowed" before URL Rewrite/ARR can forward them to the
      backend. That silently breaks every API call the SPA makes with those
      verbs. Remove it here too -- fixing only the API site is not enough,
      because the proxied request is rejected at this site first.
    -->
    <modules>
      <remove name="WebDAVModule" />
    </modules>

    <handlers>
      <remove name="WebDAV" />
    </handlers>

    <defaultDocument>
      <files>
        <remove value="Default.htm" />
        <remove value="Default.asp" />
        <remove value="index.htm" />
        <remove value="iisstart.htm" />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <staticContent>
      <!-- Hashed asset filenames from Vite are immutable -> cache aggressively -->
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
    </staticContent>

    <rewrite>
      <rules>
        <!-- 1) Reverse proxy: /api -> backend API (requires ARR proxy enabled) -->
        <rule name="ReverseProxyApi" stopProcessing="true">
          <match url="^api/(.*)" />
          <action type="Rewrite" url="http://192.168.1.34:81/api/{R:1}" logRewrittenUrl="true" />
        </rule>

        <!-- 2) Reverse proxy: /uploads -> backend static uploads (requires ARR proxy enabled) -->
        <rule name="ReverseProxyUploads" stopProcessing="true">
          <match url="^uploads/(.*)" />
          <action type="Rewrite" url="http://192.168.1.34:81/uploads/{R:1}" logRewrittenUrl="true" />
        </rule>

        <!-- 3) SPA fallback: let React Router own every URL that is not a real
                file or directory (e.g. /login, /questions/mcq, deep links) -->
        <rule name="SPA Fallback Route" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>

    <!-- Compress text assets -->
    <urlCompression doStaticCompression="true" doDynamicCompression="true" />

    <httpProtocol>
      <customHeaders>
        <!-- Optional hardening; remove if handled elsewhere -->
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
