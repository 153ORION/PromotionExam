<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS configuration for the ASP.NET Core API site (deployed on port 81).

  `dotnet publish` merges this file with the generated hosting settings, so the
  <aspNetCore> element below is rewritten at publish time with the real
  processPath/arguments. Everything else here is preserved verbatim.
-->
<configuration>
  <system.webServer>
    <!--
      IIS loads WebDAVModule whenever the "WebDAV Publishing" feature is
      installed, and that module claims the PUT, DELETE, PROPFIND, MKCOL, COPY,
      MOVE, LOCK and UNLOCK verbs for itself. It answers them with
      "405 Method Not Allowed / Allow: GET, HEAD, OPTIONS, TRACE" *before* the
      request ever reaches Kestrel, so every REST update/delete endpoint in this
      API (system config PUT, question/flowpath/registration DELETE) fails with
      no trace in the application logs. POST and PATCH are unaffected, which is
      what makes the symptom so confusing.

      Removing the module and its handler mapping at site level restores those
      verbs without touching the rest of the server.
    -->
    <modules>
      <remove name="WebDAVModule" />
    </modules>

    <handlers>
      <remove name="WebDAV" />
      <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
    </handlers>

    <aspNetCore processPath="dotnet" arguments=".\PromotionExam.WebApi.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
  </system.webServer>
</configuration>
